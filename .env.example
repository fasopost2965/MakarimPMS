# Variables lues par docker-compose.yml (docker compose charge automatiquement
# le fichier .env à la racine du dépôt). Copier en .env, remplir avec les
# valeurs réelles, ne jamais commit (.env est dans .gitignore).
#
# Incident réel (production, VITE_API_URL absente/incorrecte du .env du
# VPS) : le frontend est un SPA statique, VITE_API_URL est résolue au
# BUILD (image Docker), jamais lue au runtime par le conteneur Nginx qui la
# sert ensuite — une valeur manquante ou fausse ici produit un frontend qui
# appelle sa propre origine au lieu de l'API (405 Method Not Allowed côté
# Nginx du conteneur frontend, cf. docs/operations/CH-026E_DEPLOIEMENT_DOMAINE.md).
# Après toute correction de VITE_API_URL : `docker compose build frontend`
# (rebuild obligatoire, un `up -d` seul sert l'ancienne image).

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=pms_makarim
MYSQL_USER=pms
MYSQL_PASSWORD=pms

# --- Frontend/Backend — schéma à deux sous-domaines (docs/operations/CH-026E_DEPLOIEMENT_DOMAINE.md) ---
# Développement local (défauts déjà corrects, rien à changer) :
#   FRONTEND_URL=http://localhost:5173
#   VITE_API_URL=http://localhost:3000/api
# Production (exemple hotelmakarim.cloud — remplacer par le domaine réel) :
#   FRONTEND_URL=https://pms.hotelmakarim.cloud
#   VITE_API_URL=https://api.hotelmakarim.cloud/api
# Les deux DOIVENT être cohérentes entre elles (même paire de sous-domaines)
# — FRONTEND_URL sert au CORS backend (main.ts, CorsOptionsDelegate),
# VITE_API_URL est compilée en dur dans le bundle frontend au build.
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000/api

# CH-050 suite — base publique de l'API elle-même (pas FRONTEND_URL),
# utilisée pour construire des liens cliquables envoyés par email/WhatsApp
# (ex. téléchargement de facture) : Twilio/le client mail doit pouvoir
# l'atteindre directement, sans passer par le SPA. Même valeur que
# VITE_API_URL en pratique.
PUBLIC_API_URL=http://localhost:3000/api

# Secrets JWT — valeurs de développement ci-dessous, à régénérer avant tout
# déploiement réel (ex. openssl rand -base64 48). En NODE_ENV=production, le
# backend refuse de démarrer si l'une des deux vaut encore le défaut.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# F9 — jeton mobile housekeeping, même secret JWT_ACCESS_SECRET, TTL propre.
MOBILE_JWT_EXPIRES_IN=8h

# CH-004 — clé de chiffrement au repos de Guest.pieceIdentite (AES-256-GCM,
# 32 octets base64). Requise dans TOUS les environnements (le backend ne
# démarre pas sans elle). Générer une valeur réelle avec
# `openssl rand -base64 32` avant tout déploiement — changer de clé rend
# illisibles les valeurs déjà chiffrées avec l'ancienne.
ENCRYPTION_KEY=AqPFDtHd7Jqqh9wQnh/7ArvxgNAOK3o3sgodMRH8khw=

# NODE_ENV — laisser vide/absent en dev local. "production" sur le VPS :
# désactive la doc Swagger (/api/docs) et active la validation stricte des
# secrets JWT ci-dessus.
NODE_ENV=

# F10 — secret partagé protégeant les webhooks entrants du channel-manager
# (header X-Channel-Webhook-Secret). Absent = tout appel webhook OTA est
# refusé (fail closed). Générer avec `openssl rand -base64 32` avant tout
# déploiement, à transmettre à chaque OTA connectée.
CHANNEL_WEBHOOK_SECRET=

# SMTP (module notifications, F7) — toutes optionnelles. Si SMTP_HOST est
# absent, les emails sont journalisés au lieu d'être envoyés (dégradation
# gracieuse, pas d'erreur).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@makarim.test

# Twilio (module notifications, F7 suite — SMS/WhatsApp) — toutes
# optionnelles, même dégradation gracieuse que SMTP. TWILIO_WHATSAPP_FROM
# est le numéro WhatsApp Business SANS le préfixe "whatsapp:" (ajouté
# automatiquement).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
